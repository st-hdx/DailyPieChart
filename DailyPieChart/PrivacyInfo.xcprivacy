<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<!-- 登録した予定の名前や時間帯は端末とApp Groupの中に置くだけで外部送信しない。
	     一方で1.3から、ファネル計測(AnalyticsService.swift)により匿名のインストールID・
	     イベント名・アプリバージョン・言語をCloudflare Workerへ送信している。実名・メール等の
	     個人識別情報とは紐付けておらず、他社のトラッキングにも使わない。 -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<!-- インストール時に生成する匿名のランダムUUID(IDFA/IDFVではない) -->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeDeviceID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>
		<dict>
			<!-- イベント名(起動・予定の追加・購入結果など)とタイムスタンプ -->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeProductInteraction</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>
		<dict>
			<!-- アプリバージョン・端末の言語設定 -->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherDiagnosticData</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>
	</array>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- CA92.1: アプリ自身からしか読めない情報の読み書き
				     （レビュー依頼の履歴、共有カードのテーマ選択、データの控え） -->
				<string>CA92.1</string>
				<!-- 1C8F.1: 同一 App Group に属するアプリと拡張の間でのみ read/write
				     （スケジュールをウィジェット拡張と共有するため） -->
				<string>1C8F.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
