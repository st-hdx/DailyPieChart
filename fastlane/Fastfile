default_platform(:ios)

platform :ios do
  desc "App Store Connect のメタデータとスクリーンショットを反映する（ビルドはアップロードしない）"
  desc "使い方: bundle exec fastlane update_metadata"
  lane :update_metadata do
    deliver(
      skip_binary_upload: true,
      skip_screenshots: false,
      skip_metadata: false,
      submit_for_review: false,
      automatic_release: false
    )
  end
end
